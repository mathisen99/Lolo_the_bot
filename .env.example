# Lolo IRC Bot - Environment Variables
# Copy this file to .env and fill in your API keys

# Required for AI conversations and reasoning
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Required for Flux AI image generation/editing
# Get free credits at: https://api.bfl.ml
BFL_API_KEY=your-black-forest-labs-key-here

# Required for file hosting (images, audio, text)
# Sign up at: https://botbin.net and request a token
BOTBIN_API_KEY=your-botbin-api-key-here

# Required for YouTube Search tool
# Get your key at: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your-google-api-key-here

# IRC authentication secrets (optional; only needed if your nick is registered)
# Leave the passwords empty in config/bot.toml and set them here instead so they
# are never committed. Per-network overrides use the (uppercased) network id,
# e.g. LOLO_LIBERA_* or LOLO_RIZON_*, and fall back to the global vars below.
# LOLO_NICKSERV_PASSWORD=your-nickserv-password
# LOLO_SASL_PASSWORD=your-sasl-password
# Per-network examples:
# LOLO_LIBERA_NICKSERV_PASSWORD=your-libera-nickserv-password
# LOLO_LIBERA_SASL_PASSWORD=your-libera-sasl-password
